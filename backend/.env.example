# Production Environment Variables
NODE_ENV=production
PORT=3000

# Authentication
JWT_SECRET=d76b70a0cceaa946fd794f8591cc2ee1d98a13e7626b444c9307543526394ca6
DUMMY_OTP_ENABLED=false

# Database (Supabase)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_secret_key_here

# CORS configuration
# Comma-separated list of allowed origins (e.g., https://farmer.liv.com,https://admin.liv.com)
