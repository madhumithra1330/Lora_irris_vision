# Production Environment Variables
NODE_ENV=production
PORT=

# Authentication
JWT_SECRET=
DUMMY_OTP_ENABLED=false

# Database (Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CORS configuration
# Comma-separated list of allowed origins (e.g., https://farmer.liv.com,https://admin.liv.com)
CORS_ORIGINS=

# Hardware Calibration
TANK_HEIGHT_CM=200
TANK_MIN_DISTANCE_CM=10

# Simulation (Must be false for production)
ENABLE_SOCKET_SIMULATOR=false
